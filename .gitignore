# Secrets
.env
.env.*
!.env.example

# Dependencies
node_modules/

# Heavy media — source footage lives in Google Drive ("Claude video editor"); keep only notes here
media/**
!media/**/
!media/**/.gitkeep
!media/broll/SOURCES.md
renders/**
!renders/.gitkeep

# HyperFrames caches / build output
.hyperframes/
**/.cache/
capture*/

# OS / editor
.DS_Store
Thumbs.db
*.log

# Staged media for compositions (re-creatable from media/ and renders/)
compositions/**/media/

# REA video project (same rules as the root media/ and renders/)
REA/media/**
!REA/media/**/
!REA/media/**/.gitkeep
REA/renders/**
!REA/renders/.gitkeep
REA/compositions/**/media/

# REA remotion working media (re-creatable from REA/media and REA/renders)
REA/remotion/public/media/*.mp4
REA/remotion/public/media/*.wav
REA/remotion/out/

# REA proofs build output
REA/proofs/*/dist/

# Remotion sample footage (re-creatable from REA/media)
REA/remotion/public/samples/*.mp4
