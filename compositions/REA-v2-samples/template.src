tl.set("#s11s", { background: "#3a3d44", color: "#F6F1EC" }, 31.7);
tl.set("#s11st", { display: "none" }, 31.7);
tl.set("#s11st2", { display: "inline" }, 31.7);
tl.fromTo("#s11bi", { rotate: 0 }, { rotate: 18, duration: .08, yoyo: true, repeat: 7, ease: "none", transformOrigin: "50% 10%" }, 32.0);
tl.fromTo("#s11b", { borderColor: "rgba(255,255,255,.12)" }, { borderColor: "#E8775F", duration: .2 }, 32.0);
window.__timelines = window.__timelines || {};
window.__timelines["rea-v2-samples"] = tl;
