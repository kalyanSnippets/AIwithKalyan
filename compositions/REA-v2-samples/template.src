tl.fromTo(c7, { s: 0 }, { s: 1097, duration: 2.3, ease: "power1.in", onUpdate: () => { const s = Math.round(c7.s); e7.textContent = Math.floor(s / 60) + "m " + String(s % 60).padStart(2, "0") + "s"; } }, 18.3);
