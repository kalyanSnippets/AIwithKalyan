    <div class="k1" id="ch1b" style="top:330px;font-size:230px">WHAT IS</div><div class="k1 hot" id="ch1c" style="top:560px;font-size:300px">REA?</div></div>
  <div class="stk" id="s399" style="left:1440px;top:300px;width:420px"><div class="ic">{{i:star}}</div><div class="big" id="s399n">0</div><div class="sm">STARS</div></div>
