<!doctype html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=1920, height=1080" />
<title>REA v2 part 1 (S1–S3)</title>
<script src="vendor/gsap.min.js"></script>
<script src="words.js"></script>
<style>
@font-face { font-family: "Inter"; src: url("fonts/Inter-600.woff2") format("woff2"); font-weight: 600; font-display: block; }
@font-face { font-family: "Inter"; src: url("fonts/Inter-800.woff2") format("woff2"); font-weight: 800; font-display: block; }
:root { --bg:#0B0B0D; --ink:#F6F1EC; --mute:rgba(246,241,236,.65); --coral:#E8775F; --coralHi:#FF9E88; --steel:#7F95AB; --ok:#5BD69A; --red:#FF5A5A; }
html, body { margin:0; background:var(--bg); }
#root { position:relative; width:1920px; height:1080px; overflow:hidden; background:var(--bg); font-family:"Inter",system-ui,sans-serif; color:var(--ink); }
.fill { position:absolute; inset:0; }
.ic svg { width:100%; height:100%; display:block; }
.hot { color:var(--coral); }
/* layers */
#bd { z-index:0; opacity:0; }
.bw { z-index:3; } #camwrap { z-index:4; } .chap { z-index:5; } .stk, .pin { z-index:6; } .cap { z-index:7; } .ins { z-index:9; } #flash { z-index:10; } #scan { z-index:5; }
.blob { position:absolute; border-radius:50%; filter:blur(120px); }
#grid { background-image:linear-gradient(rgba(255,255,255,.045) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.045) 1px,transparent 1px); background-size:120px 120px; }
/* camera */
#camwrap { position:absolute; left:0; top:0; width:1920px; height:1080px; transform-origin:0 0; overflow:hidden; }
#campush { position:absolute; inset:0; transform-origin:50% 36%; }
#cam { position:absolute; inset:0; width:1920px; height:1080px; object-fit:cover; }
#camring { position:absolute; inset:0; border:0 solid var(--coral); pointer-events:none; }
/* captions */
.cap { position:absolute; left:0; right:0; bottom:70px; display:flex; justify-content:center; gap:26px; visibility:hidden; }
.w { display:inline-block; font-weight:800; font-size:84px; letter-spacing:-1px; text-transform:uppercase; color:#fff; -webkit-text-stroke:3px #000; paint-order:stroke fill; text-shadow:0 8px 0 rgba(0,0,0,.55), 0 14px 30px rgba(0,0,0,.5); opacity:0; }
.w.on { color:var(--coral); }
/* stickers */
.stk { position:absolute; visibility:hidden; border-radius:36px; background:rgba(14,14,18,.76); border:2px solid rgba(255,255,255,.14); box-shadow:0 40px 90px rgba(0,0,0,.5); display:flex; flex-direction:column; align-items:center; justify-content:center; text-align:center; gap:12px; padding:34px 30px; box-sizing:border-box; }
.stk.c { background:var(--coral); color:#111; border-color:transparent; }
.stk .ic { width:120px; height:120px; color:var(--coral); }
.stk.c .ic { color:#111; }
.stk .big { font-weight:800; font-size:92px; letter-spacing:-4px; line-height:1; }
.stk .sm { font-weight:800; font-size:28px; letter-spacing:4px; color:var(--coral); line-height:1.25; }
.stk.c .sm { color:#111; }
.stk .src { font-weight:600; font-size:17px; color:var(--mute); letter-spacing:0; }
.stk.c .src { color:rgba(0,0,0,.6); }
.col { left:1440px; top:250px; width:420px; }
.wall { left:1250px; top:110px; width:580px; }
/* browser frames */
.bw { position:absolute; left:160px; top:62px; width:1600px; border-radius:22px; overflow:hidden; background:#fff; box-shadow:0 50px 120px rgba(0,0,0,.65); border:1.5px solid rgba(255,255,255,.18); visibility:hidden; }
.chrome { height:56px; background:#1C1D22; display:flex; align-items:center; gap:12px; padding:0 22px; }
.dot { width:15px; height:15px; border-radius:50%; background:#3a3d44; }
.url { margin-left:22px; flex:1; height:36px; border-radius:18px; background:#2A2C33; display:flex; align-items:center; gap:10px; padding:0 18px; font-weight:600; font-size:21px; color:rgba(255,255,255,.7); white-space:nowrap; overflow:hidden; }
.url .ic { width:18px; height:18px; flex:none; color:rgba(255,255,255,.6); }
.url b { color:#fff; }
.cdate { padding:8px 16px; border-radius:10px; background:rgba(232,119,95,.18); color:var(--coralHi); font-weight:600; font-size:19px; white-space:nowrap; }
.view { position:relative; width:1600px; height:900px; overflow:hidden; background:#fff; }
.zoom { position:absolute; left:0; top:0; width:1600px; height:900px; transform-origin:0 0; }
.zoom img, .zoom video { position:absolute; left:0; top:0; width:1600px; height:900px; object-fit:cover; display:block; }
.hl { position:absolute; border:5px solid var(--coral); border-radius:12px; opacity:0; box-shadow:0 0 0 9999px rgba(0,0,0,0); }
.ftag { position:absolute; z-index:6; left:160px; top:20px; padding:10px 20px; border-radius:12px; background:rgba(14,14,18,.86); border:1.5px solid rgba(255,255,255,.16); font-weight:600; font-size:22px; color:var(--mute); visibility:hidden; display:flex; gap:10px; align-items:center; }
.ftag b { color:var(--ink); } .ftag .ic { width:22px; height:22px; color:var(--coral); }
/* pins on the Wekan board */
.pin { position:absolute; visibility:hidden; }
.pin .d { position:absolute; left:-13px; top:-13px; width:26px; height:26px; border-radius:50%; background:var(--coral); box-shadow:0 0 0 8px rgba(232,119,95,.35); }
.pin .l { position:absolute; left:22px; top:-62px; padding:10px 22px; border-radius:14px; background:#141418; color:#fff; font-weight:800; font-size:34px; white-space:nowrap; box-shadow:0 14px 30px rgba(0,0,0,.35); }
/* chapters and hook takeover */
.chap { position:absolute; inset:0; visibility:hidden; }
.k1 { position:absolute; left:660px; width:1200px; font-weight:800; letter-spacing:-7px; line-height:.98; white-space:nowrap; }
.big3 { display:block; font-weight:800; font-size:190px; line-height:.98; letter-spacing:-7px; white-space:nowrap; opacity:0; }
.imp { position:absolute; height:8px; border-radius:4px; background:var(--coral); opacity:0; transform:scaleX(0); transform-origin:left; }
#rea { position:absolute; left:560px; top:120px; width:1300px; height:840px; display:flex; flex-direction:column; align-items:center; justify-content:center; visibility:hidden; z-index:5; }
#reatxt { font-weight:800; font-size:440px; line-height:1; letter-spacing:-16px; }
#reatxt span { display:inline-block; }
#reabar { width:700px; height:12px; border-radius:6px; background:var(--coral); margin:-10px 0 30px; }
#reasub { font-weight:600; font-size:46px; color:var(--mute); }
.ring { position:absolute; left:50%; top:50%; width:1500px; height:1500px; margin:-750px 0 0 -750px; border-radius:50%; border:6px solid var(--coral); opacity:0; }
.pt { position:absolute; left:1210px; top:500px; width:16px; height:16px; background:var(--coral); opacity:0; }
.rgb { position:absolute; left:560px; top:120px; width:1300px; height:840px; display:flex; align-items:center; justify-content:center; mix-blend-mode:screen; opacity:0; font-weight:800; font-size:440px; letter-spacing:-16px; z-index:5; }
#scan { background:repeating-linear-gradient(0deg, rgba(255,255,255,.05) 0 2px, transparent 2px 6px); opacity:0; }
#flash { background:#fff; opacity:0; }
.ins { position:absolute; left:0; top:0; width:1920px; height:1080px; }
/* mission scene */
#term { position:absolute; left:640px; top:230px; width:1180px; height:520px; border-radius:24px; background:#101114; border:1.5px solid rgba(255,255,255,.14); box-shadow:0 40px 100px rgba(0,0,0,.6); overflow:hidden; }
.mono { font-family:"DejaVu Sans Mono","Consolas",monospace; }
.tile { position:absolute; width:330px; height:130px; white-space:nowrap; border-radius:26px; background:rgba(255,255,255,.07); border:2px solid rgba(255,255,255,.13); display:flex; align-items:center; gap:18px; padding:0 26px; box-sizing:border-box; font-weight:800; font-size:34px; }
.tile .ic { width:60px; height:60px; color:var(--coral); flex:none; }
.xrow { position:absolute; left:1240px; top:140px; display:flex; gap:28px; }
.xi { position:relative; width:170px; height:200px; border-radius:30px; background:rgba(14,14,18,.78); border:2px solid rgba(255,255,255,.14); display:flex; flex-direction:column; align-items:center; justify-content:center; gap:14px; font-weight:800; font-size:26px; letter-spacing:2px; visibility:hidden; }
.xi .ic { width:84px; height:84px; color:var(--ink); }
.xi .xx { position:absolute; inset:-10px; color:var(--red); opacity:0; }
</style>
</head>
<body>
<div id="root" data-composition-id="rea-v2-part1" data-start="0" data-width="1920" data-height="1080" data-duration="148.4">
  <div id="bd" class="fill">
    <div class="blob" id="b1" style="width:900px;height:900px;left:-250px;top:-350px;background:rgba(232,119,95,.28)"></div>
    <div class="blob" id="b2" style="width:800px;height:800px;right:-250px;bottom:-380px;background:rgba(127,149,171,.2)"></div>
    <div id="grid" class="fill"></div>
  </div>

  <!-- ===== browser frames (real proofs) ===== -->
  <div class="bw" id="bgh" style="top:150px;height:800px"><div class="view" style="height:800px"><div class="zoom" style="height:800px">
    <video id="ghv" class="clip" src="media/gh.mp4" muted playsinline data-start="32.74" data-duration="6.56" data-media-start="0" data-track-index="2" style="height:800px"></video>
    <div class="hl" id="hlStar" style="left:1330px;top:360px;width:165px;height:48px"></div>
    <div class="hl" id="hlFork" style="left:1156px;top:360px;width:170px;height:48px"></div>
  </div></div></div>
  <div class="ftag" id="tgh"><span class="ic">{{i:play}}</span>Kalyan's screen recording · <b>github.com/morluto/rea</b> · 28 Oct 2026</div>

  <div class="bw" id="bmoe"><div class="chrome"><span class="dot"></span><span class="dot"></span><span class="dot"></span><div class="url"><span class="ic">{{i:lock}}</span><b>moelueker.com</b>/blog/reverse-engineer-anything</div><div class="cdate">Source · captured 30 Oct 2026</div></div>
    <div class="view"><div class="zoom"><img src="img/moe.png"><div class="hl" id="hlMoe" style="left:262px;top:390px;width:740px;height:74px"></div></div></div></div>

  <div class="bw" id="byt"><div class="chrome"><span class="dot"></span><span class="dot"></span><span class="dot"></span><div class="url"><span class="ic">{{i:lock}}</span><b>youtube.com</b>/results?search_query=I+Tested+The+Viral+Reverse+Engineering+Repo</div><div class="cdate">Source · captured 30 Oct 2026</div></div>
    <div class="view"><div class="zoom"><img src="img/yt.png"><div class="hl" id="hlYt" style="left:800px;top:106px;width:380px;height:56px"></div></div></div></div>

  <div class="bw" id="bhow"><div class="chrome"><span class="dot"></span><span class="dot"></span><span class="dot"></span><div class="url"><span class="ic">{{i:lock}}</span><b>rea.tools</b>/#what-is-re</div><div class="cdate">Source · captured 30 Oct 2026</div></div>
    <div class="view"><div class="zoom"><img src="img/reahow.png">
      <div class="hl" id="hlH1" style="left:196px;top:428px;width:400px;height:80px"></div>
      <div class="hl" id="hlH2" style="left:600px;top:428px;width:400px;height:80px"></div>
      <div class="hl" id="hlH3" style="left:1006px;top:428px;width:400px;height:80px"></div></div></div></div>

  <div class="bw" id="bx"><div class="chrome"><span class="dot"></span><span class="dot"></span><span class="dot"></span><div class="url"><span class="ic">{{i:lock}}</span><b>x.com</b>/AIWarper/status/2109060856466264566</div><div class="cdate">Source · captured 30 Oct 2026</div></div>
    <div class="view" style="background:#F7F9F9"><div class="zoom"><img src="img/xpost.png"><div class="hl" id="hlX" style="left:10px;top:66px;width:492px;height:206px"></div></div></div></div>

  <div class="bw" id="bdx"><div class="chrome"><span class="dot"></span><span class="dot"></span><span class="dot"></span><div class="url"><span class="ic">{{i:lock}}</span><b>rea.tools</b>/showcase/dx-ball/</div><div class="cdate">Source · captured 30 Oct 2026</div></div>
    <div class="view"><div class="zoom" id="zdx"><div id="dxscroll" class="fill"><img src="img/dxtop.png" style="top:0"><img src="img/dxball.png" style="top:900px"></div>
      <div class="hl" id="hlDx" style="left:503px;top:430px;width:386px;height:37px"></div></div></div></div>

  <div class="bw" id="bno"><div class="chrome"><span class="dot"></span><span class="dot"></span><span class="dot"></span><div class="url"><span class="ic">{{i:lock}}</span><b>rea.tools</b>/showcase/notion/</div><div class="cdate">Source · captured 30 Oct 2026</div></div>
    <div class="view"><div class="zoom"><img src="img/notion.png"><div class="hl" id="hlNo" style="left:270px;top:262px;width:1060px;height:228px"></div></div></div></div>

  <div class="bw" id="bwk" style="top:150px"><div class="chrome"><span class="dot"></span><span class="dot"></span><span class="dot"></span><div class="url"><span class="ic">{{i:lock}}</span><b>boards.wekan.team</b>/b/D2SzJKZDS4Z48yeQH/wekan-r-open-source-kanban-board-with-mit-license</div><div class="cdate">Kalyan's recording · 30 Oct 2026</div></div>
    <div class="view" style="height:750px"><div class="zoom" id="zwk" style="height:750px"><img src="img/wekan.png" style="height:750px">
      <div id="ghost" style="position:absolute;left:968px;top:240px;width:300px;height:110px;border-radius:10px;border:4px dashed var(--coral);background:rgba(232,119,95,.12);opacity:0"></div>
      <div class="ic" id="hand" style="position:absolute;left:1080px;top:300px;width:64px;height:64px;color:#111;opacity:0">{{i:mouse-pointer-click}}</div>
      <div class="pin" id="p1" style="left:100px;top:125px"><div class="d"></div><div class="l">Lists</div></div>
      <div class="pin" id="p2" style="left:620px;top:200px"><div class="d"></div><div class="l">Cards</div></div>
      <div class="pin" id="p3" style="left:560px;top:358px"><div class="d"></div><div class="l">Labels</div></div>
      <div class="pin" id="p4" style="left:90px;top:470px"><div class="d"></div><div class="l">Due dates</div></div>
      <div class="pin" id="p5" style="left:700px;top:585px"><div class="d"></div><div class="l">Checklists</div></div>
      <div class="pin" id="p6" style="left:1060px;top:240px"><div class="d"></div><div class="l">Drag &amp; drop</div></div>
    </div></div></div>
  <div class="stk c" id="sKanban" style="left:160px;top:50px;width:auto;flex-direction:row;padding:14px 30px;border-radius:999px;gap:16px"><span class="ic" style="width:44px;height:44px">{{i:layout-grid}}</span><span style="font-weight:800;font-size:44px">A Kanban board</span></div>

  <div class="bw" id="brb" style="top:150px"><div class="chrome"><span class="dot"></span><span class="dot"></span><span class="dot"></span><div class="url"><span class="ic">{{i:lock}}</span><b>localhost:5173</b></div><div class="cdate">Our own app · REA Board</div></div>
    <div class="view" style="height:750px"><div class="zoom" style="height:750px"><img src="img/reaboard.png" style="height:750px">
      <div class="hl" id="hlRb1" style="left:6px;top:4px;width:300px;height:46px"></div>
      <div class="hl" id="hlRb2" style="left:8px;top:262px;width:262px;height:46px"></div></div></div></div>

  <!-- ===== camera ===== -->
  <div id="camwrap"><div id="campush">
    <video id="cam" class="clip" src="media/cam.mp4" playsinline data-has-audio="true" data-start="0" data-duration="148.4" data-media-start="0" data-track-index="1"></video>
  </div><div id="camring"></div></div>

  <!-- ===== S1 hook ===== -->
  <div class="stk" id="s400" style="left:1250px;top:120px;width:560px;height:470px;border-radius:40px">
    <div class="ic" id="s400star" style="width:180px;height:180px">{{i:star}}</div>
    <div class="big" id="s400n" style="font-size:120px;letter-spacing:-5px">0</div>
    <div class="sm" style="font-size:34px;letter-spacing:6px">STARS ON GITHUB</div></div>
  <div class="ic" id="flame" style="position:absolute;left:1430px;top:170px;width:300px;height:300px;color:var(--coral);visibility:hidden;z-index:6;filter:drop-shadow(0 20px 40px rgba(232,119,95,.45))">{{i:flame}}</div>
  <div class="chap" id="take"><div id="words" style="position:absolute;left:660px;top:150px;width:1200px"><span class="big3">REVERSE</span><span class="big3">ENGINEER</span><span class="big3 hot">ANYTHING</span></div>
    <div class="imp" id="imp1" style="left:640px;top:345px;width:1100px"></div></div>
  <div class="rgb" id="rgbR" style="color:#ff6a4d">REA</div><div class="rgb" id="rgbB" style="color:#7FB7FF">REA</div>
  <div id="rea"><div class="ring" id="r1"></div><div class="ring" id="r2"></div><div class="ring" id="r3"></div>
    <div id="reatxt"><span>R</span><span>E</span><span class="hot">A</span></div><div id="reabar"></div><div id="reasub">Reverse Engineer Anything · for short</div></div>
  <div id="pts" class="fill" style="visibility:hidden;z-index:6"></div>

  <div class="stk" id="sSide" style="left:1300px;top:150px;width:480px"><div class="ic">{{i:columns-2}}</div><div class="sm">BOTH, SIDE BY SIDE</div><div class="src">at the end of the video</div></div>
  <div class="stk c" id="sHype" style="left:1300px;top:150px;width:480px"><div class="ic" id="sHypeIc">{{i:scale}}</div><div class="big" style="font-size:66px;letter-spacing:-2px">Worth the hype?</div></div>
  <div class="stk" id="sName" style="left:1180px;top:140px;width:640px;flex-direction:row;gap:30px;padding:34px 40px;justify-content:flex-start;text-align:left">
    <div style="width:120px;height:120px;border-radius:50%;background:var(--coral);display:flex;align-items:center;justify-content:center;flex:none"><span class="ic" style="width:64px;height:64px;color:#111">{{i:play}}</span></div>
    <div><div class="big" style="font-size:80px">Kalyan</div><div class="sm" style="margin-top:10px">AI WITH KALYAN</div></div></div>

  <!-- ===== S2 ===== -->
