    <div class="stk" id="sMit" style="position:relative;flex-direction:row;padding:26px 36px;gap:22px;justify-content:flex-start"><span class="ic" style="width:70px;height:70px">{{i:scroll-text}}</span><span class="big" style="font-size:62px;white-space:nowrap">MIT license</span></div>
