  <div class="stk c" id="s35" style="left:1440px;top:300px;width:420px"><div class="ic">{{i:eye}}</div><div class="big">3.5M</div><div class="sm">VIEWS</div><div class="src">Low Level on YouTube</div></div>
  <div class="ic" id="spark" style="position:absolute;left:1450px;top:170px;width:280px;height:280px;color:var(--coral);visibility:hidden;z-index:6;filter:drop-shadow(0 20px 40px rgba(232,119,95,.45))">{{i:sparkles}}</div>
