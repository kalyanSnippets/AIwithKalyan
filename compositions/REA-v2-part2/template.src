  <div class="rsn" id="rh4"><span class="rn">4</span><span>Testing</span><span class="ic" id="rh4h" style="width:56px;height:56px;color:var(--coral)">{{i:heart}}</span></div>
  <div class="bw" id="fDone" style="top:160px"><div class="chrome"><span class="dot"></span><span class="dot"></span><span class="dot"></span><div class="url"><span class="ic">{{i:terminal}}</span><b>Claude Code</b> · REA Board clone</div><div class="cdate">Kalyan's recording · 30 Oct 2026</div></div>
    <div class="view" style="height:830px;background:#0c0c0c"><div class="zoom" style="height:830px"><img src="img/done.png" style="height:830px">
      <div class="hl" id="hlMeas" style="left:12px;top:466px;width:610px;height:34px"></div>
      <div class="hl" id="hlAll" style="left:8px;top:28px;width:560px;height:38px"></div></div></div></div>
  <div class="stk" id="sBlue" style="left:1440px;top:230px;width:420px"><div style="width:150px;height:110px;border-radius:18px;background:#2C7BD6;position:relative"><span class="ic" style="position:absolute;inset:-10px;color:var(--red)">{{i:x}}</span></div><div class="big" style="font-size:54px;letter-spacing:-1px">"looks blue"</div><div class="sm">NOT A NUMBER</div></div>
  <div class="stk" id="sHex" style="left:1440px;top:230px;width:420px"><div style="display:flex;gap:12px"><div style="width:110px;height:110px;border-radius:18px;background:#FF9F19"></div><div style="width:110px;height:110px;border-radius:18px;background:#DEDEDE"></div></div><div class="big mono" style="font-size:52px;letter-spacing:0">#ff9f19</div><div class="sm">EXACT, MEASURED</div><span class="ic" style="width:56px;height:56px">{{i:pipette}}</span></div>
  <div class="chap" id="stack">
    <div class="tl2" id="tkR" style="left:660px;top:330px"><span class="ic">{{i:atom}}</span>React</div>
    <div class="tl2" id="tkV" style="left:1060px;top:330px"><span class="ic">{{i:zap}}</span>Vite</div>
    <div class="tl2" id="tkC" style="left:1460px;top:330px"><span class="ic">{{i:file-code}}</span>Plain CSS</div>
    <div id="noLib" style="position:absolute;left:660px;top:600px;display:flex;align-items:center;gap:26px;opacity:0">
      <div style="position:relative;width:110px;height:110px"><span class="ic" style="position:absolute;inset:0;color:var(--steel)">{{i:package}}</span><span class="ic" style="position:absolute;inset:-14px;color:var(--red)">{{i:ban}}</span></div>
      <div style="position:relative;width:110px;height:110px"><span class="ic" style="position:absolute;inset:0;color:var(--steel)">{{i:package}}</span><span class="ic" style="position:absolute;inset:-14px;color:var(--red)">{{i:ban}}</span></div>
      <span style="font-weight:800;font-size:60px">No random libraries</span></div></div>
  <div class="chap" id="wire">
    <div id="wf" style="position:absolute;left:660px;top:300px;width:1180px;height:600px;border-radius:24px;background:rgba(255,255,255,.05);border:2px solid rgba(255,255,255,.12);overflow:hidden">
      <div style="height:56px;background:rgba(232,119,95,.25)"></div>
      <div class="wl" style="left:30px"><div class="wh">Lists</div><div class="wc"></div><div class="wc"></div><div class="wc"></div></div>
      <div class="wl" style="left:300px"><div class="wh"></div><div class="wc"></div><div class="wc"></div></div>
      <div class="wl" style="left:570px"><div class="wh"></div><div class="wc"></div></div>
      <div id="wPanel" style="position:absolute;right:0;top:56px;width:330px;bottom:0;background:#1d1f25;border-left:2px solid var(--coral);padding:24px;box-sizing:border-box;font-weight:800;font-size:30px;color:var(--coral)">Card panel<div style="height:24px;border-radius:8px;background:rgba(255,255,255,.12);margin-top:20px"></div><div style="height:24px;border-radius:8px;background:rgba(255,255,255,.12);margin-top:14px;width:70%"></div><div style="height:60px;border-radius:8px;background:rgba(255,255,255,.08);margin-top:14px"></div></div>
      <div id="wDrag" style="position:absolute;left:36px;top:150px;width:228px;height:70px;border-radius:12px;background:var(--coral);opacity:0;box-shadow:0 20px 40px rgba(0,0,0,.4)"></div></div>
    <div id="wLbl" style="position:absolute;left:660px;top:930px;display:flex;gap:22px"><span class="wlb">Lists</span><span class="wlb">Cards</span><span class="wlb">Card panel</span><span class="wlb">Drag &amp; drop</span></div></div>
  <div class="chap" id="test">
    <div id="tList" style="position:absolute;left:660px;top:280px;width:1050px">
      <div class="ti"><span class="tb"></span>Drag a card between lists<span class="tk2">✓</span></div>
      <div class="ti"><span class="tb"></span>Edit a card in the panel<span class="tk2">✓</span></div>
      <div class="ti"><span class="tb"></span>Refresh keeps everything<span class="tk2">✓</span></div></div>
    <div class="ic" id="tEye" style="position:absolute;left:1700px;top:290px;width:170px;height:170px;color:var(--coral)">{{i:eye}}</div>
    <div id="tSaw" style="position:absolute;left:660px;top:720px;font-weight:800;font-size:52px;color:var(--coral);opacity:0">Ticked only if Claude SAW it work</div></div>
  <div class="chap" id="prove">
    <div id="bub" style="position:absolute;left:700px;top:300px;padding:40px 60px;border-radius:50px 50px 50px 10px;background:rgba(255,255,255,.08);border:2px solid rgba(255,255,255,.15);font-weight:800;font-size:110px">"Done ✅"<span id="bubQ" style="color:var(--coral);opacity:0"> ?</span></div>
    <div id="stamp" style="position:absolute;left:1000px;top:580px;padding:20px 50px;border:10px solid var(--coral);border-radius:20px;color:var(--coral);font-weight:800;font-size:100px;letter-spacing:6px;transform:rotate(-8deg);opacity:0">PROVE IT</div></div>
  <div class="chap" id="enter">
    <div id="key" style="position:absolute;left:900px;top:320px;width:440px;height:300px;border-radius:40px;background:linear-gradient(#2a2c33,#1a1b20);border:3px solid rgba(255,255,255,.18);box-shadow:0 26px 0 #0e0f12,0 50px 80px rgba(0,0,0,.6);display:flex;align-items:center;justify-content:center;gap:24px;font-weight:800;font-size:90px">Enter<span class="ic" style="width:90px;height:90px;color:var(--coral)">{{i:corner-down-left}}</span></div>
    <div id="wait" style="position:absolute;left:960px;top:720px;display:flex;align-items:center;gap:22px;opacity:0"><span class="ic" id="waitI" style="width:80px;height:80px;color:var(--coral)">{{i:hourglass}}</span><span style="font-weight:800;font-size:64px">Now we wait…</span></div></div>

  <!-- ===== S8 ===== -->
  <div class="stk c" id="s50" style="left:1440px;top:230px;width:420px"><svg width="200" height="200" viewBox="0 0 200 200"><circle cx="100" cy="100" r="84" stroke="rgba(0,0,0,.18)" stroke-width="18" fill="none"/><circle id="ring50" cx="100" cy="100" r="84" stroke="#111" stroke-width="18" fill="none" stroke-linecap="round" stroke-dasharray="528" stroke-dashoffset="528" transform="rotate(-90 100 100)"/><text id="n50" x="100" y="118" text-anchor="middle" font-family="Inter" font-weight="800" font-size="56" fill="#111">0/50</text></svg><div class="sm">CHECKS PASSED</div></div>
  <div class="stk" id="sWait" style="left:1300px;top:150px;width:500px"><div class="ic">{{i:hourglass}}</div><div class="big" style="font-size:72px">But wait…</div></div>
  <div class="chap" id="poll"><div class="k1" id="pollT" style="top:130px;font-size:110px;letter-spacing:-4px">How close is the <span class="hot">copy?</span></div>
    <div id="pollRow" style="position:absolute;left:660px;top:380px;display:flex;gap:40px"><div class="pb">50%</div><div class="pb">80%</div><div class="pb" style="border-color:var(--coral)">90%?</div></div>
    <div id="pollC" style="position:absolute;left:660px;top:740px;display:flex;align-items:center;gap:16px;padding:20px 36px;border-radius:999px;background:var(--coral);color:#111;font-weight:800;font-size:52px;opacity:0"><span class="ic" style="width:56px;height:56px">{{i:message-circle}}</span>Comment your guess</div>
    <div id="pollH" style="position:absolute;left:1420px;top:752px;display:flex;align-items:center;gap:12px;font-weight:800;font-size:38px;opacity:0"><span class="ic" style="width:48px;height:48px;color:var(--coral)">{{i:heart}}</span>I read every one</div></div>

  <video class="clip ins" id="insRun" src="media/r_RunTerm.mp4" muted playsinline data-start="114.65" data-duration="40.05" data-media-start="0" data-track-index="3"></video>
  <div id="scan" class="fill"></div>
  <div id="flash" class="fill"></div>
</div>
<script>
const rnd = (() => { let s = 20261030; return () => { s |= 0; s = (s + 0x6D2B79F5) | 0; let t = Math.imul(s ^ (s >>> 15), 1 | s); t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t; return ((t ^ (t >>> 14)) >>> 0) / 4294967296; }; })();
let tl = gsap.timeline({ paused: true });
const main = tl;
const bo = "back.out(1.7)", p3 = "power3.out";
const $ = (s) => document.querySelector(s);

// ---------- background drift ----------
tl.fromTo("#b1", { x: 0, y: 0 }, { x: 300, y: 160, duration: 171.6, ease: "none" }, 0);
tl.fromTo("#grid", { x: 0 }, { x: -600, duration: 171.6, ease: "none" }, 0);

// ---------- camera: full frame ↔ PiP card ----------
function pipIn(t, d = .5) {
  tl.to("#bd", { opacity: 1, duration: Math.min(.3, d) }, t);
  tl.to("#camwrap", { x: 56, y: 1080 - 56 - 1080 * .28, scale: .28, borderRadius: 120, duration: d, ease: "expo.inOut" }, t);
  tl.to("#camring", { borderWidth: 16, borderRadius: 120, duration: d, ease: "expo.inOut" }, t);
}
function pipOut(t, d = .45) {
  tl.to("#camwrap", { x: 0, y: 0, scale: 1, borderRadius: 0, duration: d, ease: "expo.inOut" }, t);
  tl.to("#camring", { borderWidth: 0, borderRadius: 0, duration: d, ease: "expo.inOut" }, t);
  tl.to("#bd", { opacity: 0, duration: Math.min(.3, d) }, t + d * .5);
}
function whip(t) { // fast push + blur, then flash
  tl.to("#campush", { scale: 1.35, filter: "blur(14px)", duration: .28, ease: "power3.in" }, t);
  tl.fromTo("#flash", { opacity: 0 }, { opacity: .55, duration: .06, yoyo: true, repeat: 1, ease: "none", immediateRender: false }, t + .26);
  tl.set("#campush", { scale: 1, filter: "blur(0px)" }, t + .4);
}
function punch(a, b, s = 1.15) {
  tl.to("#campush", { scale: s, duration: .32, ease: p3 }, a);
  tl.to("#campush", { scale: 1, duration: .3, ease: p3 }, b);
}

// ---------- stickers ----------
function stk(id, a, b, from = { scale: .3, rotate: 10, opacity: 0, x: 160 }) {
  tl.set(id, { visibility: "visible" }, a);
  tl.fromTo(id, from, { scale: 1, rotate: id.length % 2 ? -3 : 3, opacity: 1, x: 0, duration: .45, ease: bo, immediateRender: false }, a);
  tl.to(id, { x: 600, rotate: 12, opacity: 0, duration: .3, ease: "power3.in" }, b - .3);
  tl.set(id, { visibility: "hidden" }, b);
}
function icPop(id, a, b) {
  tl.set(id, { visibility: "visible" }, a);
  tl.fromTo(id, { scale: 0, rotate: -40 }, { scale: 1, rotate: 8, duration: .4, ease: bo, immediateRender: false }, a);
  tl.to(id, { rotate: -8, duration: .12, yoyo: true, repeat: 3, ease: "sine.inOut" }, a + .45);
  tl.to(id, { scale: 0, duration: .2, ease: "power2.in" }, b - .2);
  tl.set(id, { visibility: "hidden" }, b);
}
function count(sel, to, a, d, fmt = (v) => Math.round(v).toLocaleString("en-US")) {
  const el = $(sel), c = { v: 0 };
  tl.to(c, { v: to, duration: d, ease: "power3.out", onUpdate: () => { el.textContent = fmt(c.v); } }, a);
}

// ---------- browser proof frames ----------
function showB(id, a, b, tag) {
  tl.set(id, { visibility: "visible" }, a);
  tl.fromTo(id, { y: 700, rotateX: 18, scale: .9, opacity: 1 }, { y: 0, rotateX: 0, scale: 1, duration: .6, ease: "expo.out", transformPerspective: 2000, immediateRender: false }, a);
  tl.to(id, { y: -80, scale: .94, opacity: 0, duration: .3, ease: "power2.in" }, b - .3);
  tl.set(id, { visibility: "hidden" }, b);
  if (tag) { tl.set(tag, { visibility: "visible" }, a + .3); tl.fromTo(tag, { y: -30, opacity: 0 }, { y: 0, opacity: 1, duration: .3, immediateRender: false }, a + .3); tl.set(tag, { visibility: "hidden" }, b - .3); }
}
function zoomTo(zid, t, s, px, py, d = .8, vw = 1600, vh = 900) { // center point (px,py) at scale s
  const x = Math.min(0, Math.max(vw - vw * s, vw / 2 - px * s)), y = Math.min(0, Math.max(vh - vh * s, vh / 2 - py * s));
  tl.to(zid, { scale: s, x, y, duration: d, ease: "power3.inOut" }, t);
}
function hl(id, a, b, dim = true) {
  tl.to(id, { opacity: 1, duration: .01 }, a);
  tl.fromTo(id, { scaleX: 0 }, { scaleX: 1, transformOrigin: "left center", duration: .35, ease: p3, immediateRender: false }, a);
  if (dim) tl.to(id, { boxShadow: "0 0 0 9999px rgba(0,0,0,.3)", duration: .4 }, a + .15);
  if (b) tl.to(id, { opacity: 0, boxShadow: "0 0 0 9999px rgba(0,0,0,0)", duration: .25 }, b);
}
function shiftL(id, t) { tl.to(id, { x: -220, scale: .8, duration: .55, ease: "power3.inOut" }, t); }

// ===== content timeline, authored in CUT time (REA/edits/REA-v2.cut-words.json), shifted by -B =====
const B = 145.65;
tl = gsap.timeline(); main.add(tl, 0); const C = tl;
function typeIn(sel, at, d = .6) { // typed command
  const el = $(sel), txt = el.dataset.t, k = { n: 0 };
  tl.to(k, { n: txt.length, duration: d, ease: "none", onUpdate: () => { el.textContent = txt.slice(0, Math.round(k.n)); } }, at);
}
function win(id, a, b) {
  tl.set(id, { visibility: "visible" }, a);
  tl.fromTo(id, { y: 80, opacity: 0, scale: .95 }, { y: 0, opacity: 1, scale: 1, duration: .45, ease: p3, immediateRender: false }, a);
  tl.to(id, { opacity: 0, y: -40, duration: .25 }, b - .25);
  tl.set(id, { visibility: "hidden" }, b);
}
function chap(id, a, b) { tl.set(id, { visibility: "visible", opacity: 1 }, a); tl.to(id, { opacity: 0, duration: .25 }, b - .25); tl.set(id, { visibility: "hidden" }, b); }
function step(n, a, d = .95) {
  const id = "#st" + n;
  chap(id, a, a + d);
  tl.fromTo(id + " .snum", { scale: 1.6, opacity: 0, filter: "blur(20px)" }, { scale: 1, opacity: 1, filter: "blur(0px)", duration: .45, ease: "expo.out", immediateRender: false }, a);
  tl.fromTo(id + " .sic", { scale: 0, rotate: -90 }, { scale: 1, rotate: 0, duration: .45, ease: bo, immediateRender: false }, a + .08);
  tl.fromTo(id + " .stt", { x: 120, opacity: 0 }, { x: 0, opacity: 1, duration: .4, ease: p3, immediateRender: false }, a + .12);
  if (n === 3) tl.fromTo(id + " .sbadge", { scale: 0 }, { scale: 1, duration: .35, ease: bo, immediateRender: false }, a + .3);
  const dots = document.querySelectorAll("#stDots span");
  tl.set(dots[n - 1], { attr: { class: "on" } }, a);
  tl.fromTo(dots[n - 1], { scale: 1 }, { scale: 1.3, duration: .2, yoyo: true, repeat: 1, immediateRender: false }, a);
}

// ---------- S4 · subscribe (145.65 – 156.3) ----------
stk("#sReq", 146.75, 149.9, { y: -40, opacity: 0, scale: .8, rotate: 0, x: 0 });
stk("#subCard", 150.2, 155.2);
tl.fromTo("#subCur", { x: 260, y: 160, opacity: 0 }, { x: 0, y: 0, opacity: 1, duration: .45, ease: "power2.out", immediateRender: false }, 150.3);
tl.to("#subCur", { scale: .8, duration: .08, yoyo: true, repeat: 1 }, 150.78);
tl.to("#subB", { scale: .92, duration: .08, yoyo: true, repeat: 1 }, 150.78);
tl.set("#subB", { background: "#3a3d44", color: "#F6F1EC" }, 150.86); tl.set("#subT1", { display: "none" }, 150.86); tl.set("#subT2", { display: "inline" }, 150.86);
tl.to("#bellI", { rotate: 18, duration: .08, yoyo: true, repeat: 7, ease: "none", transformOrigin: "50% 10%" }, 151.05);
tl.to("#subCur", { x: -470, y: -10, duration: .35, ease: "power2.inOut" }, 151.5);
tl.to("#likeB", { background: "#E8775F", scale: 1.15, duration: .2, ease: bo }, 151.9); tl.to("#likeB", { scale: 1, duration: .2 }, 152.15);
tl.to("#subCur", { opacity: 0, duration: .2 }, 152.6);
tl.to("#growR", { opacity: 1, duration: .3 }, 153.55); tl.fromTo("#growR", { y: 20 }, { y: 0, duration: .35, ease: bo, immediateRender: false }, 153.55);
whip(155.95);

// ---------- S5 · setup (156.3 – 208.4) ----------
stk("#sWin", 156.6, 158.35);
pipIn(158.3);
tl.set("#stDots", { visibility: "visible" }, 158.4); tl.fromTo("#stDots", { y: -40, opacity: 0 }, { y: 0, opacity: 1, duration: .35, immediateRender: false }, 158.4);
step(1, 158.45);
win("#w1", 159.35, 161.6); typeIn("#w1 .ty", 160.65);
step(2, 161.62);
win("#w2", 162.5, 167.05); typeIn("#w2 div:nth-child(1) .ty", 164.74, .7); typeIn("#w2 div:nth-child(2) .ty", 166.1, .55);
step(3, 167.07);
win("#w3", 168.05, 171.55); typeIn("#w3 .ty", 170.08, .5);
tl.to("#w3", { scale: 1.04, duration: .15, yoyo: true, repeat: 1 }, 170.6);
// real: "Install the guided REA skill?" → Yes → "REA is ready"
showB("#fSkill", 171.5, 179.35);
