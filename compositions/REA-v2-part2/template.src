<!doctype html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=1920, height=1080" />
<title>REA v2 part 2 (S4–S8)</title>
<script src="vendor/gsap.min.js"></script>
<script src="words.js"></script>
<style>
@font-face { font-family: "Inter"; src: url("fonts/Inter-600.woff2") format("woff2"); font-weight: 600; font-display: block; }
@font-face { font-family: "Inter"; src: url("fonts/Inter-800.woff2") format("woff2"); font-weight: 800; font-display: block; }
:root { --bg:#0B0B0D; --ink:#F6F1EC; --mute:rgba(246,241,236,.65); --coral:#E8775F; --coralHi:#FF9E88; --steel:#7F95AB; --ok:#5BD69A; --red:#FF5A5A; }
html, body { margin:0; background:var(--bg); }
#root { position:relative; width:1920px; height:1080px; overflow:hidden; background:var(--bg); font-family:"Inter",system-ui,sans-serif; color:var(--ink); }
.fill { position:absolute; inset:0; }
.ic svg { width:100%; height:100%; display:block; }
.hot { color:var(--coral); }
/* layers */
#bd { z-index:0; opacity:0; }
.bw { z-index:3; } #camwrap { z-index:4; } .chap { z-index:5; } .stk, .pin { z-index:6; } .cap { z-index:7; } .ins { z-index:9; } #flash { z-index:10; } #scan { z-index:5; }
.blob { position:absolute; border-radius:50%; filter:blur(120px); }
#grid { background-image:linear-gradient(rgba(255,255,255,.045) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.045) 1px,transparent 1px); background-size:120px 120px; }
/* camera */
#camwrap { position:absolute; left:0; top:0; width:1920px; height:1080px; transform-origin:0 0; overflow:hidden; }
#campush { position:absolute; inset:0; transform-origin:50% 36%; }
#cam { position:absolute; inset:0; width:1920px; height:1080px; object-fit:cover; }
#camring { position:absolute; inset:0; border:0 solid var(--coral); pointer-events:none; }
/* captions */
.cap { position:absolute; left:0; right:0; bottom:70px; display:flex; justify-content:center; gap:26px; visibility:hidden; }
.w { display:inline-block; font-weight:800; font-size:84px; letter-spacing:-1px; text-transform:uppercase; color:#fff; -webkit-text-stroke:3px #000; paint-order:stroke fill; text-shadow:0 8px 0 rgba(0,0,0,.55), 0 14px 30px rgba(0,0,0,.5); opacity:0; }
.w.on { color:var(--coral); }
/* stickers */
.stk { position:absolute; visibility:hidden; border-radius:36px; background:rgba(14,14,18,.76); border:2px solid rgba(255,255,255,.14); box-shadow:0 40px 90px rgba(0,0,0,.5); display:flex; flex-direction:column; align-items:center; justify-content:center; text-align:center; gap:12px; padding:34px 30px; box-sizing:border-box; }
.stk.c { background:var(--coral); color:#111; border-color:transparent; }
.stk .ic { width:120px; height:120px; color:var(--coral); }
.stk.c .ic { color:#111; }
.stk .big { font-weight:800; font-size:92px; letter-spacing:-4px; line-height:1; }
.stk .sm { font-weight:800; font-size:28px; letter-spacing:4px; color:var(--coral); line-height:1.25; }
.stk.c .sm { color:#111; }
.stk .src { font-weight:600; font-size:17px; color:var(--mute); letter-spacing:0; }
.stk.c .src { color:rgba(0,0,0,.6); }
.col { left:1440px; top:250px; width:420px; }
.wall { left:1250px; top:110px; width:580px; }
/* browser frames */
.bw { position:absolute; left:160px; top:62px; width:1600px; border-radius:22px; overflow:hidden; background:#fff; box-shadow:0 50px 120px rgba(0,0,0,.65); border:1.5px solid rgba(255,255,255,.18); visibility:hidden; }
.chrome { height:56px; background:#1C1D22; display:flex; align-items:center; gap:12px; padding:0 22px; }
.dot { width:15px; height:15px; border-radius:50%; background:#3a3d44; }
.url { margin-left:22px; flex:1; height:36px; border-radius:18px; background:#2A2C33; display:flex; align-items:center; gap:10px; padding:0 18px; font-weight:600; font-size:21px; color:rgba(255,255,255,.7); white-space:nowrap; overflow:hidden; }
.url .ic { width:18px; height:18px; flex:none; color:rgba(255,255,255,.6); }
.url b { color:#fff; }
.cdate { padding:8px 16px; border-radius:10px; background:rgba(232,119,95,.18); color:var(--coralHi); font-weight:600; font-size:19px; white-space:nowrap; }
.view { position:relative; width:1600px; height:900px; overflow:hidden; background:#fff; }
.zoom { position:absolute; left:0; top:0; width:1600px; height:900px; transform-origin:0 0; }
.zoom img, .zoom video { position:absolute; left:0; top:0; width:1600px; height:900px; object-fit:cover; display:block; }
.hl { position:absolute; border:5px solid var(--coral); border-radius:12px; opacity:0; box-shadow:0 0 0 9999px rgba(0,0,0,0); }
.ftag { position:absolute; z-index:6; left:160px; top:20px; padding:10px 20px; border-radius:12px; background:rgba(14,14,18,.86); border:1.5px solid rgba(255,255,255,.16); font-weight:600; font-size:22px; color:var(--mute); visibility:hidden; display:flex; gap:10px; align-items:center; }
.ftag b { color:var(--ink); } .ftag .ic { width:22px; height:22px; color:var(--coral); }
/* pins on the Wekan board */
.pin { position:absolute; visibility:hidden; }
.pin .d { position:absolute; left:-13px; top:-13px; width:26px; height:26px; border-radius:50%; background:var(--coral); box-shadow:0 0 0 8px rgba(232,119,95,.35); }
.pin .l { position:absolute; left:22px; top:-62px; padding:10px 22px; border-radius:14px; background:#141418; color:#fff; font-weight:800; font-size:34px; white-space:nowrap; box-shadow:0 14px 30px rgba(0,0,0,.35); }
/* chapters and hook takeover */
.chap { position:absolute; inset:0; visibility:hidden; }
.k1 { position:absolute; left:660px; width:1200px; font-weight:800; letter-spacing:-7px; line-height:.98; white-space:nowrap; }
.big3 { display:block; font-weight:800; font-size:190px; line-height:.98; letter-spacing:-7px; white-space:nowrap; opacity:0; }
.imp { position:absolute; height:8px; border-radius:4px; background:var(--coral); opacity:0; transform:scaleX(0); transform-origin:left; }
#rea { position:absolute; left:560px; top:120px; width:1300px; height:840px; display:flex; flex-direction:column; align-items:center; justify-content:center; visibility:hidden; z-index:5; }
#reatxt { font-weight:800; font-size:440px; line-height:1; letter-spacing:-16px; }
#reatxt span { display:inline-block; }
#reabar { width:700px; height:12px; border-radius:6px; background:var(--coral); margin:-10px 0 30px; }
#reasub { font-weight:600; font-size:46px; color:var(--mute); }
.ring { position:absolute; left:50%; top:50%; width:1500px; height:1500px; margin:-750px 0 0 -750px; border-radius:50%; border:6px solid var(--coral); opacity:0; }
.pt { position:absolute; left:1210px; top:500px; width:16px; height:16px; background:var(--coral); opacity:0; }
.rgb { position:absolute; left:560px; top:120px; width:1300px; height:840px; display:flex; align-items:center; justify-content:center; mix-blend-mode:screen; opacity:0; font-weight:800; font-size:440px; letter-spacing:-16px; z-index:5; }
#scan { background:repeating-linear-gradient(0deg, rgba(255,255,255,.05) 0 2px, transparent 2px 6px); opacity:0; }
#flash { background:#fff; opacity:0; }
.ins { position:absolute; left:0; top:0; width:1920px; height:1080px; }
/* mission scene */
#term { position:absolute; left:640px; top:230px; width:1180px; height:520px; border-radius:24px; background:#101114; border:1.5px solid rgba(255,255,255,.14); box-shadow:0 40px 100px rgba(0,0,0,.6); overflow:hidden; }
.mono { font-family:"DejaVu Sans Mono","Consolas",monospace; }
.tile { position:absolute; width:330px; height:130px; white-space:nowrap; border-radius:26px; background:rgba(255,255,255,.07); border:2px solid rgba(255,255,255,.13); display:flex; align-items:center; gap:18px; padding:0 26px; box-sizing:border-box; font-weight:800; font-size:34px; }
.tile .ic { width:60px; height:60px; color:var(--coral); flex:none; }
.xrow { position:absolute; left:1240px; top:140px; display:flex; gap:28px; }
.xi { position:relative; width:170px; height:200px; border-radius:30px; background:rgba(14,14,18,.78); border:2px solid rgba(255,255,255,.14); display:flex; flex-direction:column; align-items:center; justify-content:center; gap:14px; font-weight:800; font-size:26px; letter-spacing:2px; visibility:hidden; }
.xi .ic { width:84px; height:84px; color:var(--ink); }
.xi .xx { position:absolute; inset:-10px; color:var(--red); opacity:0; }
/* part 2 additions */
.step .snum { position:absolute; left:660px; top:150px; font-weight:800; font-size:520px; line-height:1; letter-spacing:-20px; color:transparent; -webkit-text-stroke:6px var(--coral); }
.step .sic { position:absolute; left:1160px; top:260px; width:170px; height:170px; padding:40px; border-radius:50%; background:rgba(232,119,95,.16); color:var(--coral); }
.step .stt { position:absolute; left:1160px; top:560px; width:740px; font-weight:800; font-size:100px; line-height:1.02; letter-spacing:-4px; }
.step .sbadge { position:absolute; left:1160px; top:800px; padding:12px 26px; border-radius:999px; background:var(--coral); color:#111; font-weight:800; font-size:30px; letter-spacing:4px; }
.dots { position:absolute; left:660px; top:90px; display:flex; gap:20px; z-index:6; visibility:hidden; }
.dots span { width:64px; height:64px; border-radius:50%; border:3px solid rgba(255,255,255,.18); display:flex; align-items:center; justify-content:center; font-weight:800; font-size:28px; color:var(--mute); background:rgba(14,14,18,.6); }
.dots span.on { background:var(--coral); border-color:var(--coral); color:#111; }
.cw { position:absolute; left:640px; top:240px; width:1200px; border-radius:24px; overflow:hidden; background:#0E0F12; border:1.5px solid rgba(255,255,255,.14); box-shadow:0 40px 100px rgba(0,0,0,.6); visibility:hidden; z-index:3; }
.cw .bar { height:58px; display:flex; align-items:center; gap:12px; padding:0 24px; background:#1A1C21; font-size:24px; color:var(--mute); font-weight:600; }
.cb { padding:44px 50px 54px; font-size:46px; line-height:1.6; color:var(--ink); }
.pp { color:var(--steel); }
.ty { color:var(--coral); font-weight:700; }
.pq { position:absolute; left:660px; width:860px; height:120px; border-radius:24px; background:rgba(255,255,255,.07); border:2px solid rgba(255,255,255,.14); display:flex; align-items:center; padding:0 36px; box-sizing:border-box; font-weight:600; font-size:44px; gap:14px; }
.pq .pk { margin-left:auto; width:76px; height:76px; border-radius:50%; background:var(--ok); color:#0b0b0d; display:flex; align-items:center; justify-content:center; font-weight:800; font-size:44px; }
.wd { width:110px; height:110px; border-radius:50%; background:rgba(255,255,255,.08); border:3px solid rgba(255,255,255,.16); display:flex; align-items:center; justify-content:center; font-weight:800; font-size:56px; }
.rsn { position:absolute; left:660px; top:36px; display:flex; align-items:center; gap:24px; font-weight:800; font-size:64px; letter-spacing:-2px; visibility:hidden; z-index:6; }
.rsn .rn { width:96px; height:96px; border-radius:50%; background:var(--coral); color:#111; display:flex; align-items:center; justify-content:center; font-size:58px; }
.tl2 { position:absolute; width:360px; height:200px; border-radius:30px; background:rgba(255,255,255,.07); border:2px solid rgba(255,255,255,.14); display:flex; flex-direction:column; align-items:center; justify-content:center; gap:16px; font-weight:800; font-size:52px; }
.tl2 .ic { width:80px; height:80px; color:var(--coral); }
.wl { position:absolute; top:80px; width:240px; }
.wh { height:34px; border-radius:8px; background:rgba(255,255,255,.18); margin-bottom:14px; font-weight:800; font-size:24px; padding-left:10px; line-height:34px; color:var(--ink); }
.wc { height:70px; border-radius:12px; background:rgba(255,255,255,.1); margin-bottom:14px; }
.wlb { padding:12px 26px; border-radius:999px; background:rgba(255,255,255,.08); border:2px solid rgba(255,255,255,.14); font-weight:800; font-size:34px; opacity:0; }
.ti { display:flex; align-items:center; gap:30px; height:130px; font-weight:800; font-size:50px; white-space:nowrap; }
.tb { width:70px; height:70px; border-radius:16px; border:5px solid rgba(255,255,255,.35); }
.tk2 { margin-left:20px; width:76px; height:76px; border-radius:50%; background:var(--ok); color:#0b0b0d; display:flex; align-items:center; justify-content:center; font-size:46px; opacity:0; }
.pb { width:340px; height:260px; border-radius:40px 40px 40px 8px; background:rgba(255,255,255,.07); border:2px solid rgba(255,255,255,.14); display:flex; align-items:center; justify-content:center; font-weight:800; font-size:120px; }
</style>
</head>
<body>
<div id="root" data-composition-id="rea-v2-part2" data-start="0" data-width="1920" data-height="1080" data-duration="171.6">
  <div id="bd" class="fill">
    <div class="blob" id="b1" style="width:900px;height:900px;left:-250px;top:-350px;background:rgba(232,119,95,.28)"></div>
    <div class="blob" id="b2" style="width:800px;height:800px;right:-250px;bottom:-380px;background:rgba(127,149,171,.2)"></div>
    <div id="grid" class="fill"></div>
  </div>
  <div id="camwrap"><div id="campush">
    <video id="cam" class="clip" src="media/cam.mp4" playsinline data-has-audio="true" data-start="0" data-duration="171.6" data-media-start="0" data-track-index="1"></video>
  </div><div id="camring"></div></div>
  <!-- ===== S4 subscribe ===== -->
  <div class="stk c" id="sReq" style="left:1300px;top:150px;width:auto;flex-direction:row;padding:20px 34px;border-radius:999px;gap:16px"><span class="ic" style="width:50px;height:50px">{{i:heart}}</span><span style="font-weight:800;font-size:48px">One simple request</span></div>
  <div class="stk" id="subCard" style="left:1180px;top:120px;width:660px;padding:40px">
    <div style="display:flex;align-items:center;gap:26px">
      <div id="likeB" style="width:120px;height:120px;border-radius:50%;background:rgba(255,255,255,.08);display:flex;align-items:center;justify-content:center"><span class="ic" style="width:64px;height:64px;color:var(--ink)">{{i:thumbs-up}}</span></div>
      <div id="subB" style="padding:30px 44px;border-radius:999px;background:var(--coral);color:#111;font-weight:800;font-size:48px"><span id="subT1">SUBSCRIBE</span><span id="subT2" style="display:none">SUBSCRIBED</span></div>
      <div id="bellB" style="width:120px;height:120px;border-radius:50%;background:rgba(255,255,255,.08);display:flex;align-items:center;justify-content:center"><span class="ic" id="bellI" style="width:64px;height:64px;color:var(--ink)">{{i:bell}}</span></div></div>
    <div id="growR" style="display:flex;align-items:center;gap:14px;margin-top:26px;opacity:0"><span class="ic" style="width:56px;height:56px">{{i:trending-up}}</span><span class="sm" style="font-size:30px">HELPS THIS CHANNEL GROW</span></div>
    <div class="ic" id="subCur" style="position:absolute;left:330px;top:250px;width:70px;height:70px;color:#fff;filter:drop-shadow(0 6px 10px rgba(0,0,0,.6))">{{i:mouse-pointer-2}}</div></div>

  <!-- ===== S5 setup ===== -->
  <div class="stk" id="sWin" style="left:1300px;top:150px;width:520px"><div class="ic">{{i:terminal}}</div><div class="big" style="font-size:60px;letter-spacing:-2px">Windows</div><div class="sm">POWERSHELL</div></div>
  <div class="chap step" id="st1"><div class="snum">1</div><div class="sic ic">{{i:folder}}</div><div class="stt">Go to Documents</div></div>
  <div class="chap step" id="st2"><div class="snum">2</div><div class="sic ic">{{i:folder-plus}}</div><div class="stt">Make a project folder</div></div>
  <div class="chap step" id="st3"><div class="snum">3</div><div class="sic ic">{{i:package}}</div><div class="stt">Install REA</div><div class="sbadge">THE MAIN STEP</div></div>
  <div class="chap step" id="st4"><div class="snum">4</div><div class="sic ic">{{i:plug}}</div><div class="stt">Connect to Claude Code</div></div>
  <div class="chap step" id="st5"><div class="snum">5</div><div class="sic ic">{{i:terminal}}</div><div class="stt">Start Claude Code</div></div>
  <div class="dots" id="stDots"><span>1</span><span>2</span><span>3</span><span>4</span><span>5</span></div>

  <div class="cw" id="w1"><div class="bar"><span class="dot"></span><span class="dot"></span><span class="dot"></span>&nbsp; Windows PowerShell</div><div class="cb mono">
    <div><span class="pp">PS C:\Users\you&gt;</span> <span class="ty" data-t="cd $HOME\Documents"></span></div></div></div>
  <div class="cw" id="w2"><div class="bar"><span class="dot"></span><span class="dot"></span><span class="dot"></span>&nbsp; Windows PowerShell</div><div class="cb mono">
    <div><span class="pp">PS …\Documents&gt;</span> <span class="ty" data-t="mkdir kanban-rea-demo"></span></div>
    <div><span class="pp">PS …\Documents&gt;</span> <span class="ty" data-t="cd kanban-rea-demo"></span></div></div></div>
  <div class="cw" id="w3"><div class="bar"><span class="dot"></span><span class="dot"></span><span class="dot"></span>&nbsp; Windows PowerShell</div><div class="cb mono">
    <div><span class="pp">PS …\kanban-rea-demo&gt;</span> <span class="ty" data-t="npx rea-agents"></span></div></div></div>
  <div class="cw" id="w4"><div class="bar"><span class="dot"></span><span class="dot"></span><span class="dot"></span>&nbsp; Windows PowerShell</div><div class="cb mono" style="font-size:34px">
    <div><span class="pp">PS …\kanban-rea-demo&gt;</span></div><div><span class="ty" data-t="claude mcp add rea -- cmd /c npx -y rea-agents@latest mcp"></span></div>
    <div style="margin-top:18px"><span class="pp">PS …\kanban-rea-demo&gt;</span> <span class="ty" data-t="claude mcp list"></span></div>
    <div id="w4ok" style="color:var(--ok);font-weight:700;opacity:0">rea: cmd /c npx -y rea-agents@latest mcp · ✓ Connected</div></div></div>
  <div class="cw" id="w5"><div class="bar"><span class="dot"></span><span class="dot"></span><span class="dot"></span>&nbsp; Windows PowerShell</div><div class="cb mono">
    <div><span class="pp">PS …\kanban-rea-demo&gt;</span> <span class="ty" data-t="claude"></span></div></div></div>
  <div class="stk c" id="sBoom" style="left:1300px;top:110px;width:auto;padding:20px 34px;flex-direction:row;gap:14px;border-radius:999px"><span class="ic" style="width:56px;height:56px">{{i:circle-check-big}}</span><span style="font-weight:800;font-size:56px">BOOM! Connected</span></div>

  <!-- real recording stills (Kalyan's 114128 run) -->
  <div class="bw" id="fSkill" style="top:180px"><div class="chrome"><span class="dot"></span><span class="dot"></span><span class="dot"></span><div class="url"><span class="ic">{{i:terminal}}</span><b>Windows PowerShell</b> · npx rea-agents</div><div class="cdate">Kalyan's recording · 30 Oct 2026</div></div>
    <div class="view" style="height:514px;background:#0c0c0c"><div class="zoom" style="height:514px"><img src="img/skill.png" style="height:514px">
      <div class="hl" id="hlSk1" style="left:44px;top:268px;width:720px;height:44px"></div>
      <div class="hl" id="hlSk2" style="left:44px;top:456px;width:650px;height:44px"></div></div></div></div>
  <div class="stk c" id="sYes" style="left:1440px;top:250px;width:420px"><div class="ic">{{i:circle-check-big}}</div><div class="big">YES</div><div class="sm">GUIDED REA SKILL</div></div>
  <div class="stk" id="sEasy" style="left:1440px;top:250px;width:420px"><div class="ic">{{i:thumbs-up}}</div><div class="big" style="font-size:80px">Easy!</div></div>

  <div class="bw" id="fTheme"><div class="chrome"><span class="dot"></span><span class="dot"></span><span class="dot"></span><div class="url"><span class="ic">{{i:terminal}}</span><b>claude</b> · first run</div><div class="cdate">Kalyan's recording · 30 Oct 2026</div></div>
    <div class="view" style="height:830px;background:#0c0c0c"><div class="zoom" style="height:830px"><img src="img/theme.png" style="height:830px">
      <div class="hl" id="hlTh" style="left:88px;top:416px;width:170px;height:38px"></div></div></div></div>
  <div class="bw" id="fAuth" style="left:600px;width:1000px"><div class="chrome"><span class="dot"></span><span class="dot"></span><span class="dot"></span><div class="url"><span class="ic">{{i:lock}}</span><b>claude.ai</b> · sign in</div><div class="cdate">Kalyan's recording</div></div>
    <div class="view" style="width:1000px;height:839px;background:#fafafa"><div class="zoom" style="width:1000px;height:839px"><img src="img/auth.png" style="width:1000px;height:839px">
      <div class="hl" id="hlAu" style="left:44px;top:652px;width:726px;height:66px"></div></div></div></div>
  <div class="bw" id="fAuto" style="top:200px"><div class="chrome"><span class="dot"></span><span class="dot"></span><span class="dot"></span><div class="url"><span class="ic">{{i:terminal}}</span><b>Claude Code</b> v2.1.312</div><div class="cdate">Kalyan's recording · 30 Oct 2026</div></div>
    <div class="view" style="height:416px;background:#0c0c0c"><div class="zoom" style="height:416px"><img src="img/auto.png" style="height:416px">
      <div class="hl" id="hlOp" style="left:144px;top:58px;width:360px;height:36px"></div>
      <div class="hl" id="hlAm" style="left:62px;top:368px;width:190px;height:38px"></div></div></div></div>
  <div id="opRow" style="position:absolute;left:640px;top:760px;display:flex;gap:30px;z-index:6">
    <div class="stk c" id="sOpus" style="position:relative;flex-direction:row;padding:22px 34px;gap:14px;border-radius:999px"><span class="ic" style="width:50px;height:50px">{{i:sparkles}}</span><span style="font-weight:800;font-size:48px">Opus 5.5</span></div>
    <div class="stk" id="sAuto" style="position:relative;flex-direction:row;padding:22px 34px;gap:14px;border-radius:999px"><span class="ic" style="width:50px;height:50px">{{i:shield-check}}</span><span style="font-weight:800;font-size:48px">Auto mode on</span></div></div>

  <!-- auto mode: permissions approve themselves -->
  <div class="chap" id="perm">
    <div style="position:absolute;left:660px;top:90px;display:flex;align-items:center;gap:22px" id="permT"><span class="ic" style="width:84px;height:84px;color:var(--coral)">{{i:shield-check}}</span><span style="font-weight:800;font-size:84px;letter-spacing:-3px">Auto mode</span></div>
    <div class="pq" id="pq1" style="top:250px">Allow: <b>npm install</b>?<span class="pk">✓</span></div>
    <div class="pq" id="pq2" style="top:400px">Allow: <b>start dev server</b>?<span class="pk">✓</span></div>
    <div class="pq" id="pq3" style="top:550px">Allow: <b>edit src/App.jsx</b>?<span class="pk">✓</span></div>
    <div class="pq" id="pq4" style="top:700px">Allow: <b>open Chrome</b>?<span class="pk">✓</span></div>
    <div id="noClick" style="position:absolute;left:1560px;top:380px;width:200px;height:200px;opacity:0"><span class="ic" style="position:absolute;inset:30px;color:var(--ink)">{{i:mouse-pointer-2}}</span><span class="ic" style="position:absolute;inset:0;color:var(--red)">{{i:ban}}</span></div>
    <div class="stk c" id="sNice" style="left:1500px;top:640px;width:300px;visibility:visible;opacity:0"><div class="ic" style="width:90px;height:90px">{{i:thumbs-up}}</div><div class="big" style="font-size:64px">Nice</div></div>
  </div>

  <!-- ===== S6 prompt ===== -->
  <div class="chap" id="chP"><div id="chPa" style="position:absolute;left:660px;top:230px;font-weight:800;font-size:52px;letter-spacing:8px;color:var(--mute)">THE MOST IMPORTANT PART</div>
    <div class="k1" id="chPb" style="top:310px;font-size:230px">THE</div><div class="k1 hot" id="chPc" style="top:520px;font-size:260px">PROMPT</div></div>
  <div class="chap" id="chS"><div class="ic" id="chSi" style="position:absolute;left:700px;top:200px;width:220px;height:220px;color:var(--coral)">{{i:key-round}}</div>
    <div class="k1" id="chSa" style="top:450px;font-size:150px">the real</div><div class="k1 hot" id="chSb" style="top:620px;font-size:190px">SECRET</div></div>
  <div class="bw" id="fPrompt" style="top:160px"><div class="chrome"><span class="dot"></span><span class="dot"></span><span class="dot"></span><div class="url"><span class="ic">{{i:terminal}}</span><b>Claude Code</b> · prompt</div><div class="cdate">Pasted text +46 lines</div></div>
    <div class="view" style="height:830px;background:#0c0c0c"><div class="zoom" style="height:830px"><img src="img/prompt.png" style="height:830px">
      <div class="hl" id="hlMf" style="left:28px;top:420px;width:370px;height:40px"></div></div></div></div>
  <div class="stk c" id="sDesc" style="left:1440px;top:250px;width:420px"><div class="ic">{{i:file-code}}</div><div class="big" style="font-size:52px;letter-spacing:-1px">Full prompt</div><div class="sm">IN THE DESCRIPTION</div><div class="ic" id="sDescA" style="width:70px;height:70px">{{i:arrow-down}}</div></div>
  <div class="chap" id="why"><div class="k1" style="top:250px;font-size:150px">Why does it</div><div class="k1 hot" style="top:420px;font-size:190px">work?</div>
    <div id="whyDots" style="position:absolute;left:670px;top:700px;display:flex;gap:28px"><span class="wd">1</span><span class="wd">2</span><span class="wd">3</span><span class="wd">4</span></div></div>
