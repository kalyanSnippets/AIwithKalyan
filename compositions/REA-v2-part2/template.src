const c50 = { v: 0 }, n50 = $("#n50"), r50 = $("#ring50");
tl.to(c50, { v: 50, duration: .8, ease: "power3.out", onUpdate: () => { n50.textContent = Math.round(c50.v) + "/50"; r50.setAttribute("stroke-dashoffset", 528 * (1 - c50.v / 50)); } }, 302.68);
pipOut(304.05);
stk("#sWait", 304.15, 306.45);
pipIn(306.5);
chap("#poll", 306.55, 315.9);
tl.fromTo("#pollT", { opacity: 0, y: -50 }, { opacity: 1, y: 0, duration: .4, ease: bo, immediateRender: false }, 307.15);
const pbs = document.querySelectorAll(".pb"); [310.32, 311.34, 312.24].forEach((at, i) => tl.fromTo(pbs[i], { scale: 0, rotate: -8 }, { scale: 1, rotate: 0, duration: .45, ease: bo, immediateRender: false }, at));
tl.to(".pb", { y: -18, duration: .3, yoyo: true, repeat: 1, ease: "sine.inOut", stagger: .12 }, 313.0);
tl.to("#pollC", { opacity: 1, duration: .25 }, 312.9); tl.fromTo("#pollC", { y: 60 }, { y: 0, duration: .4, ease: bo, immediateRender: false }, 312.9);
tl.to("#pollH", { opacity: 1, duration: .3 }, 314.5);
pipOut(315.85);
whip(316.85);

C.shiftChildren(-B);
tl = main;
// ---------- captions (local time = cut − B), hidden while graphics carry the words ----------
const HIDE = [[146.75, 149.9], [150.2, 155.2], [158.3, 304.05], [306.5, 315.9]].map(([a, b]) => [a - B, b - B]);
const HOT = new Set(["subscribe", "like", "grow.", "start.", "windows", "powershell.", "rea.", "secret.", "prompt,", "guess,", "wait,", "fifty", "eighty", "ninety?", "comments", "see.", "ready?"]);

const hidden = (t) => HIDE.some(([a, b]) => t >= a && t < b);
const groups = []; let g = null;
for (const [txt, s, e] of window.CUT_WORDS) {
  if (hidden(s)) { g = null; continue; }
  if (!g || g.w.length >= 4 || s - g.end > .3 || /[.?!:]$/.test(g.w[g.w.length - 1][0])) { g = { w: [], end: e }; groups.push(g); }
  g.w.push([txt, s]); g.end = e;
}
const root = $("#root");
groups.forEach((gr, i) => {
  const d = document.createElement("div"); d.className = "cap";
  gr.w.forEach(([txt]) => { const s = document.createElement("span"); s.className = "w" + (HOT.has(txt.toLowerCase()) ? " on" : ""); s.textContent = txt.replace(/[,.]$/, ""); d.appendChild(s); });
  root.appendChild(d);
  const a = gr.w[0][1], next = groups[i + 1] ? groups[i + 1].w[0][1] : gr.end + .4;
  let b = Math.min(next, gr.end + .45); const h = HIDE.find(([x]) => x > a && x < b); if (h) b = h[0];
  tl.set(d, { visibility: "visible" }, a);
  d.querySelectorAll(".w").forEach((w, k) => tl.fromTo(w, { scale: .2, y: 40, opacity: 0, rotate: -6 }, { scale: 1, y: 0, opacity: 1, rotate: 0, duration: .24, ease: "back.out(2.4)", immediateRender: false }, gr.w[k][1]));
  tl.set(d, { visibility: "hidden" }, b);
});
window.__timelines["rea-v2-part2"] = main;
</script>
